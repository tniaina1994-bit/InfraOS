# InfraOS backend — copiez vers .env (dev) ou /etc/infraos/infraos.env (prod).
# Les variables INFRAOS_* priment sur /etc/infraos/infraos.yaml.
INFRAOS_DB_URL=sqlite:////var/lib/infraos/infraos.db
# Prod/ISO : INFRAOS_DB_URL=postgresql+psycopg2://infraos:SECRET@localhost:5432/infraos
INFRAOS_REDIS_URL=redis://127.0.0.1:6379/0
INFRAOS_JWT_SECRET=change-me-32-chars-minimum-en-prod
INFRAOS_ADMIN_PASSWORD=change-me
INFRAOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INFRAOS_RATE_LOGIN_N=5
# LDAP/AD/Kerberos (phase 2) :
# INFRAOS_LDAP_URL=
# INFRAOS_LDAP_BASE_DN=
# INFRAOS_AD_DOMAIN=
# INFRAOS_KERBEROS_REALM=

[Unit]
Description=InfraOS API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/infraos/backend/app
ExecStart=/opt/infraos/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
Environment=PYTHONPATH=/opt/infraos/backend/app/core
Environment=INFRAOS_DATA_DIR=/var/lib/infraos

[Install]
WantedBy=multi-user.target
